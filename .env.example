# Copy this file to .env and fill in your keys. .env is never committed.

# --- OpenRouter (FREE tier — the only key needed) ---
# Get a key at https://openrouter.ai/keys
# One key fronts models from several labs, so the default fan-out in
# app/config/tasks.yaml is a real cross-vendor second opinion at zero cost.
OPENROUTER_API_KEY=

# Free models available today (all `:free`, all US labs, all streaming-capable).
# The UI's agent panel fetches this list live from OpenRouter; these are the
# ids to use in tasks.yaml:
#
#   nvidia/nemotron-3-ultra-550b-a55b:free    1M ctx  — biggest free model
#   nvidia/nemotron-3-super-120b-a12b:free  262k ctx  — strong mid-tier
#   nvidia/nemotron-3-nano-30b-a3b:free     256k ctx  — fast small MoE
#   nvidia/nemotron-nano-9b-v2:free         128k ctx  — fastest; good summarizer
#   google/gemma-4-31b-it:free              262k ctx  — image/video in
#   google/gemma-4-26b-a4b-it:free          262k ctx  — MoE, full sampler params
#   openai/gpt-oss-20b:free                 131k ctx  — reasoning_effort, logprobs
#
# RATE LIMITS: free models allow 20 requests/minute and 50 requests/day until
# 10 credits have been purchased on the account, then 1000/day. The default
# two-agent line-up is 2 requests per turn; `research` adds a summarizer for 3.
#OPENROUTER_MODEL=openai/gpt-oss-20b:free   # fallback when a task names no model
#OPENROUTER_SITE_URL=http://localhost:5173  # attribution header, describes this app
#OPENROUTER_APP_TITLE=A1A                   # attribution header, describes this app

# --- Direct first-party providers (dormant) ---
# These adapters talk straight to each vendor's own API with its own key. They
# exist for the eventual switch to paid frontier models, but no task in
# app/config/tasks.yaml uses them — setting a key alone will not spend money.
# To activate one: add the key here AND add the provider name to a task's
# agent list in tasks.yaml.
#GOOGLE_API_KEY=          # https://aistudio.google.com/apikey (has a free tier)
#GOOGLE_MODEL=gemini-3.1-flash-lite
#GOOGLE_SECONDARY_MODEL=gemini-3-flash-preview
#OPENAI_API_KEY=          # https://platform.openai.com/api-keys (pay-as-you-go)
#OPENAI_MODEL=gpt-5-mini
#ANTHROPIC_API_KEY=       # https://platform.claude.com Console → API keys (pay-as-you-go)
#ANTHROPIC_MODEL=claude-opus-4-8

# --- Optional tuning (defaults in app/config/settings.py) ---
#REQUEST_TIMEOUT_SECONDS=30
#MAX_RETRIES=3
#MAX_CUSTOM_AGENTS=6      # cap on the agent panel's roster (calls per turn)
#ENABLE_REDACTION=true
#QUIET_LOGS=true
